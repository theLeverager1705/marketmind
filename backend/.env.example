# Server
API_PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Auth - change this to a long random string in production
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_HOURS=24

# Admin who can open the Database page (if empty, the first registered user is admin)
ADMIN_EMAIL=

# Database file (SQLite)
DB_PATH=./data/marketmind.db

# AI - leave ANTHROPIC_API_KEY empty to run the agents in offline demo mode
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
